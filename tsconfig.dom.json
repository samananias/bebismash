{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": [
    "src/components/**/*",
    "src/store/**/*",
    "src/styles/**/*",
    "src/core/**/*",
    "src/services/**/*",
    "src/App.tsx",
    "src/main.tsx",
    "src/vite-env.d.ts"
  ],
  "exclude": ["src/workers/**/*", "src/codecs/**/*", "functions/**/*"]
}
